{
  "name": "sqlite-browser-editor",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "postinstall": "bun scripts/copy-sqlite-wasm.ts",
    "predev": "bun scripts/copy-sqlite-wasm.ts",
    "prebuild": "bun scripts/copy-sqlite-wasm.ts",
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --workspace",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:debug": "tauri build --debug --no-bundle",
    "mcp": "cargo run -q -p sequill-mcp --",
    "changeset": "changeset",
    "version-packages": "changeset version && bun scripts/sync-cargo-version.ts",
    "version:check": "bun scripts/sync-cargo-version.ts --check",
    "icons": "bun scripts/generate-icons.ts"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "3.1.3",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@lezer/highlight": "^1.2.5",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@tauri-apps/api": "2.12.5",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "comlink": "^4.4.2",
    "figma-squircle": "1.1.0",
    "motion": "^14.7.1",
    "papaparse": "^5.7.0",
    "prismjs": "1.30.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "simple-icons": "^16.38.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "9",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "bun@1.2.9",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
